[user]
	name = Andrew Smith
[commit]
	gpgsign = true
[gpg]
	format = ssh
[push]
	default = simple
[branch]
	autosetuprebase = always
[core]
	autocrlf = false
	editor = zed --wait
	excludesfile = ~/.gitignore
[init]
	defaultBranch = main
[include]
	# The 1Password bits (op-ssh-sign, sshCommand). Empty for the work profile,
	# which has no 1Password; signing itself stays on above for both.
	path = ~/.gitconfig.os
[include]
	# Machine-specific signing key: not tracked or symlinked, since each dev
	# machine has its own. See rebuild.sh's post-activation reminder.
	path = ~/.gitconfig.local
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
